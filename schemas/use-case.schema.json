{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ubuntu-capital.local/schemas/use-case.schema.json",
  "title": "Ubuntu Capital Use Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "useCaseId",
    "domainCode",
    "name",
    "objective",
    "primaryActor",
    "supportingActors",
    "evidenceStatus",
    "sourceReferences",
    "preconditions",
    "trigger",
    "mainFlow",
    "alternateFlows",
    "exceptionFlows",
    "postconditions",
    "businessRules",
    "dataEntities",
    "integrations",
    "permissions",
    "auditRequirements",
    "nonFunctionalRequirements",
    "dependencies",
    "priority",
    "risk",
    "acceptanceCriteria",
    "e2eCompletionCriteria",
    "e2eEvidenceRequired"
  ],
  "properties": {
    "useCaseId": {"type": "string", "pattern": "^UC-[A-Z0-9]+-[0-9]{3}$"},
    "domainCode": {"type": "string", "pattern": "^[A-Z0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "primaryActor": {"type": "string", "minLength": 1},
    "supportingActors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidenceStatus": {"enum": ["CONFIRMED", "INFERRED", "UNKNOWN", "CONTRADICTED"]},
    "sourceReferences": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[0-9]{3}$"}, "uniqueItems": true},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "trigger": {"type": "string", "minLength": 1},
    "mainFlow": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "alternateFlows": {"type": "array", "items": {"type": "string"}},
    "exceptionFlows": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "businessRules": {"type": "array", "items": {"type": "string"}},
    "dataEntities": {"type": "array", "items": {"type": "string"}},
    "integrations": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "auditRequirements": {"type": "array", "items": {"type": "string"}},
    "nonFunctionalRequirements": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "priority": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "acceptanceCriteria": {"type": "array", "items": {"type": "string"}},
    "e2eCompletionCriteria": {"type": "array", "items": {"type": "string"}},
    "e2eEvidenceRequired": {"type": "array", "items": {"type": "string"}}
  }
}
